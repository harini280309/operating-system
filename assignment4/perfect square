import math

def min_perfect_squares(n):
    dp = [0] + [float('inf')] * n
    for i in range(1, n + 1):
        j = 1
        while j*j <= i:
            dp[i] = min(dp[i], dp[i - j*j] + 1)
            j += 1
    return dp[n]

# Example usage
n = 12
print("Least number of perfect squares:", min_perfect_squares(n))
